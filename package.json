{
  "name": "omp-slack",
  "version": "0.3.0",
  "description": "Slack for OMP through the ChatGPT Slack app: one discoverable slack command plus read-only slack:// URLs for read, glob, and grep, with the plugin's own ChatGPT sign-in",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatoli-tsinovoy/omp-slack.git"
  },
  "files": [
    "src",
    "skills",
    "commands",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsgo -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=19.2.1",
    "@oh-my-pi/pi-coding-agent": ">=19.2.1",
    "@oh-my-pi/pi-tui": ">=19.2.1"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "19.2.1",
    "@oh-my-pi/pi-coding-agent": "19.2.1",
    "@oh-my-pi/pi-tui": "19.2.1",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  }
}
